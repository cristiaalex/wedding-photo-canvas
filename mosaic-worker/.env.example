# --- HTTP ---
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ===== Mosaic Pet worker — dedicated deployment =====
# Every value below must belong to the Mosaic Pet infrastructure. Do NOT reuse
# tokens, URLs or keys from any other product/deployment.

# --- Auth between the Mosaic Pet frontend and this worker ---
# The frontend sends this as PET_WORKER_API_TOKEN; generate a fresh random string.
# Long random string. Required on every POST /generate request as
#   Authorization: Bearer <WORKER_API_TOKEN>
WORKER_API_TOKEN=change-me

# --- Supabase (the PET project) ---
SUPABASE_URL=https://YOUR-PET-PROJECT.supabase.co
# Service-role key. NEVER expose to the browser. Required for storage writes
# and bypassing RLS while updating the mosaics table.
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_STORAGE_BUCKET=mosaics
# Temporary customer source photos bucket.
SUPABASE_PHOTOS_BUCKET=photos

# --- Worker tuning ---
# How many mosaic jobs may run in parallel inside this single worker instance.
MAX_CONCURRENT_JOBS=2
# Soft cap per job (milliseconds). Jobs exceeding this are marked failed.
JOB_TIMEOUT_MS=900000

# --- HTTP ---
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ===== Mosaic Pet worker — dedicated deployment =====
# Every value below must belong to the Mosaic Pet infrastructure. Do NOT reuse
# tokens, URLs or keys from any other product/deployment. Leave values empty
# here; set them only in the Pet deployment's environment.

# --- Auth between the Mosaic Pet app and this worker ---
# The app sends the same value from its PET_WORKER_API_TOKEN secret as
#   Authorization: Bearer <token>   on every POST /generate, /optimize, /archive
PET_WORKER_API_TOKEN=

# --- Pet Supabase project (service role — NEVER expose to the browser) ---
PET_SUPABASE_URL=
PET_SUPABASE_SERVICE_ROLE_KEY=

# --- Pet storage buckets (must match the app's VITE_PET_*_BUCKET values) ---
# mosaics = long-lived final products; photos = temporary source assets.
PET_MOSAICS_BUCKET=mosaics
PET_PHOTOS_BUCKET=photos

# --- Worker tuning ---
# How many mosaic jobs may run in parallel inside this single worker instance.
MAX_CONCURRENT_JOBS=2
# Soft cap per job (milliseconds). Jobs exceeding this are marked failed.
JOB_TIMEOUT_MS=900000
